{
  "name": "fixwire",
  "version": "0.1.0",
  "description": "A modern, fully-typed FIX protocol engine for TypeScript — correct session layer, great DX.",
  "type": "module",
  "license": "MIT",
  "author": "Samartha Hegde",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartha-hegde/fixwire.git"
  },
  "keywords": [
    "fix",
    "fix-protocol",
    "fix44",
    "trading",
    "quickfix",
    "financial",
    "fintech"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx examples/demo.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
