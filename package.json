{
  "name": "fixwire",
  "version": "0.3.0",
  "description": "A modern, fully-typed FIX protocol engine for TypeScript. Correct session layer, zero dependencies, great DX.",
  "type": "module",
  "license": "MIT",
  "author": "Samartha Hegde",
  "homepage": "https://samartha-hegde.github.io/fixwire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartha-hegde/fixwire.git"
  },
  "keywords": [
    "fix",
    "fix-protocol",
    "fix44",
    "trading",
    "quickfix",
    "financial",
    "fintech"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx examples/demo.ts",
    "generate": "node --import tsx scripts/generate.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
